# Cloud APIs + optional Spark LAN
VITE_DEFAULT_PROVIDER=spark

# Prefer local cloud-key-proxy (:17332) so the browser never holds the key and avoids CF 1010
VITE_FEATHERLESS_BASE_URL=http://127.0.0.1:17332/featherless/v1
# Optional when using the proxy (proxy uses FEATHERLESS_API_KEY from abliterated_ui/.env)
VITE_FEATHERLESS_API_KEY=

VITE_ABLITERATION_BASE_URL=https://api.abliteration.ai/v1
VITE_ABLITERATION_API_KEY=

# Spark Qwen Flash (Flash-Next NVFP4) — served as qwen-abliterated on DGX Spark
VITE_SPARK_HOST=192.168.4.103
VITE_SPARK_PORT=8000
# true = use http://127.0.0.1:17332/spark/<host>/<port>/v1 when page is localhost/LAN
VITE_SPARK_USE_PROXY=true
# usually empty for local vLLM
VITE_SPARK_API_KEY=

# MemPalace MCP Bridge (:17333)
VITE_MEMPALACE_URL=http://127.0.0.1:17333


# DGX self-enhance (agent monitor + chat optimizer)
VITE_AGENT_MONITOR_URL=http://100.66.147.53:17335
VITE_RESPONSE_OPTIMIZER_URL=http://100.66.147.53:17337

# Bright Data residential SuperProxy (optional egress for http_get_json).
# All four must be set for brightdata-residential; otherwise direct. Never commit secrets.
# Usual residential SuperProxy: host brd.superproxy.io port 22225; username encodes zone.
BRIGHTDATA_HOST=
BRIGHTDATA_PORT=
BRIGHTDATA_USER=
BRIGHTDATA_PASS=
