{
  "name": "web-api-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "aiui": "./scripts/aiui-agent.mjs",
    "aiui-agent": "./scripts/aiui-agent.mjs"
  },
  "scripts": {
    "cli": "bash ./aiui",
    "terminal": "bash ./aiui",
    "bench": "node ./scripts/benchmark.mjs",
    "benchmark": "node ./scripts/benchmark.mjs",
    "menu": "bash ./aiui menu",
    "aiui": "bash ./aiui",
    "aiui:setup": "bash ./scripts/install/setup-aiui-quickstart.sh",
    "aiui:install": "bash ./scripts/install-device-cli.sh",
    "aiui:bundle": "node ./scripts/install/build-client-dist.mjs",
    "bridge": "node ./scripts/mempalace-bridge.mjs",
    "serve:install": "node ./scripts/install/serve-installer.mjs",
    "dev": "vite",
    "agent": "bash ./aiui",
    "agent:deploy:spark": "node ./scripts/cluster/deploy-agent-to-spark.mjs",
    "agent:evolve": "python3 ./lab/evolution/agent_strategy_evolution.py",
    "agent:evolve:apply": "python3 ./lab/evolution/agent_strategy_evolution.py --apply-policy",
    "optimize": "node ./scripts/monitors/chat-response-optimizer.mjs",
    "optimise": "node ./scripts/monitors/chat-response-optimizer.mjs",
    "build": "tsc -b && vite build",
    "matrix": "bash ./scripts/matrix.sh",
    "lint": "oxlint",
    "test": "node --test src/lib/contextCompactor.test.ts src/lib/commandSpaceEngine.test.ts src/lib/chatResponseOptimizer.test.ts src/lib/goalVerification.test.ts src/lib/dynamicToolManager.test.ts src/lib/sandboxEnvEnforcement.test.ts src/lib/autonomyEnhancements.test.ts src/lib/providers.spark.test.ts src/lib/thinkingOptions.test.ts src/lib/palaceOrchestrator.test.ts scripts/browser-runs/proof.test.mjs scripts/aiui-agent/tools/http-get-json.test.mjs",
    "browser:proof": "node --input-type=module -e \"import { runBlueprintProof } from './scripts/browser-runs/supervisor.mjs'; const r = await runBlueprintProof(); console.log(JSON.stringify(r.record || r, null, 2)); process.exit(r.ok ? 0 : 1)\"",
    "preview": "vite preview",
    "stack": "bash ./start-stack.sh",
    "stack:status": "bash ./start-stack.sh status",
    "stack:stop": "bash ./start-stack.sh stop",
    "endpoints": "node ./scripts/cluster/check-endpoints.mjs",
    "check:endpoints": "node ./scripts/cluster/check-endpoints.mjs",
    "telemetry:cluster": "python3 ./scripts/cluster/fetch_cluster_telemetry.py",
    "monitor:agent": "node ./scripts/monitor-agent-responses.mjs",
    "monitor:agent:probe": "node ./scripts/monitor-agent-responses.mjs --probe",
    "monitor:agent:tail": "node ./scripts/monitor-agent-responses.mjs --tail",
    "monitor:self-awareness": "node ./scripts/monitors/sys-self-improvement-monitor.mjs",
    "test:effectiveness": "node ./scripts/monitors/test-effectiveness-over-time.mjs",
    "ship": "bash ./scripts/ship-to-dgx.sh",
    "runtime:deploy": "bash ./scripts/dgx-runtime/install-dgx-runtime.sh",
    "spark:speed": "node ./scripts/restart-spark.mjs --profile=speed",
    "spark:extended": "node ./scripts/restart-spark.mjs --profile=extended",
    "spark:reclaim": "node ./scripts/restart-spark.mjs --reclaim",
    "spark:restart": "node ./scripts/restart-spark.mjs",
    "spark:status": "node ./scripts/restart-spark.mjs --status",
    "spark:find": "node ./scripts/cluster/find-spark.mjs",
    "spark:stop": "node ./scripts/restart-spark.mjs --stop",
    "bench:latency": "node ./scripts/benchmark.mjs --mode=latency",
    "bench:throughput": "node ./scripts/benchmark.mjs --mode=throughput",
    "bench:agent": "node ./scripts/benchmark.mjs --mode=agent-eval",
    "spark:sandboxes": "node ./scripts/cluster/inspect-spark-sandboxes.mjs",
    "sys:summary": "node ./scripts/monitors/sys-summary.mjs",
    "git:inspect": "node ./scripts/git/git-inspect.mjs",
    "git:push": "node ./scripts/git/git-sync.mjs",
    "scaffolds:check": "node ./scripts/checks/compare-scaffolds.mjs",
    "scaffolds:verify": "node ./scripts/checks/write-scaffolds.mjs",
    "env:list": "node ./scripts/checks/list-env-values.mjs",
    "aiuiro:inspect": "node ./scripts/git/inspect-aiuiro.mjs",
    "aiuiro:push": "node ./scripts/git/push-aiuiro.mjs",
    "feather:test": "node ./scripts/cluster/test-featherless.mjs",
    "feather:deploy": "node ./scripts/cluster/deploy-featherless-healing.mjs",
    "feather:enhance": "node ./scripts/cluster/enhance-and-deploy.mjs",
    "aiuiro:push:all": "node ./scripts/git/push-all-aiuiro.mjs",
    "git:inspect:all": "node ./scripts/git/inspect-all-git-status.mjs",
    "git:push:all": "node ./scripts/git/push-all-repos.mjs",
    "git:sync:push": "node ./scripts/git/sync-and-push.mjs",
    "monitor:optimize": "node ./scripts/monitors/chat-response-optimizer.mjs",
    "monitor:optimize:policy": "curl -s http://127.0.0.1:17337/api/policy | python3 -m json.tool",
    "mempalace:inspect": "node ./scripts/memory/inspect-mempalace-db.mjs",
    "mempalace:prune": "node ./scripts/memory/prune-mempalace-wings.mjs",
    "mempalace:prune:apply": "node ./scripts/memory/prune-mempalace-wings.mjs --apply",
    "agent:evolve:daemon": "python3 ./lab/evolution/agent_strategy_evolution.py --daemon",
    "agent:evolve:test": "python3 ./lab/evolution/test_agent_evolution_integration.py",
    "agent:tools:test": "node ./scripts/checks/test-dynamic-tool-acquisition.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
